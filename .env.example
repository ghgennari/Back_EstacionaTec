# Copie para .env no servidor e preencha as senhas antes de iniciar.
WEB_SOURCE_PATH=../estacionatec-web
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
# API acessivel pelo Nginx; a porta direta fica restrita ao servidor.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
DB_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
# Origem exata do front-end, se ele acessar a API diretamente pelo navegador.
CORS_ALLOWED_ORIGINS=
CAMERA_SOURCE=IP
# Senha RTSP da camera, codificada para URL (por exemplo, @ vira %40).
# Preencha no .env privado do servidor; nunca envie esse arquivo ao Git.
CAMERA_PASSWORD=
